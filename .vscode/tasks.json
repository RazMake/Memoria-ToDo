{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build desktop app",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Memoria-ToDo\\dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}/src/Desktop/App/Memoria.ToDo.Desktop.App.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "release a version",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}\\.agents\\release.mjs"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_ROOT": "${env:LOCALAPPDATA}\\Memoria-ToDo\\dotnet",
          "PATH": "${env:LOCALAPPDATA}\\Memoria-ToDo\\dotnet;${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
