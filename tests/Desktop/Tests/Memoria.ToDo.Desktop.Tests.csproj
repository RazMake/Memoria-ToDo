    <ProjectReference Include="..\..\..\src\Desktop\Platform\Memoria.ToDo.Desktop.Platform.csproj" />
    <ProjectReference Include="..\..\..\src\Desktop\Shell\Memoria.ToDo.Desktop.Shell.csproj" />
    <ProjectReference Include="..\..\..\src\Desktop\TaskEditor\Memoria.ToDo.Desktop.TaskEditor.csproj" />
    <ProjectReference Include="..\..\..\src\Desktop\TaskList\Memoria.ToDo.Desktop.TaskList.csproj" />
    <ProjectReference Include="..\..\..\src\Desktop\Updates\Memoria.ToDo.Desktop.Updates.csproj" />
    <ProjectReference Include="..\Fakes\Memoria.ToDo.Desktop.Fakes.csproj" />
