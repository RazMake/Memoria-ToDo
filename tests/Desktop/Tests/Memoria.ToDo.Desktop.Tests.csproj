  <PropertyGroup>
    <TargetFramework>$(MemoriaAppTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Desktop\App\Memoria.ToDo.Desktop.App.csproj" />
    <ProjectReference Include="..\..\..\src\Desktop\Configure\Memoria.ToDo.Desktop.Configure.csproj" />
